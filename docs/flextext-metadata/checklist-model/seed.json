              "label": "Staged Events 2b",
              "alternatives": [
                "Staged Events 1b"
              ],
              "recommended": true,
              "order": 3
            }
          ]
        }
      ]
    },
    {
      "id": "idb",
      "label": "IDB Handbook",
      "short": "IDB",
      "accent": "#6E7A73",
      "source": "SIL Indonesia Branch Handbook §4.1",
      "sourceNote": "Original byte-size measures (300kb/50kb plain ASCII) and FIESTA were Shoebox/Toolbox-era and are not carried over; the tiering is preserved as text counts.",
      "rules": [
        {
          "id": "idb-30",
          "kind": "count",
          "label": "30 texts with free translations",
          "min": 30,
          "requiredSteps": [
            "transcribe",
            "ft-lwc"
          ]
        },
        {
          "id": "idb-genres",
          "kind": "eachChild",
          "label": "≥2 texts of each discourse genre naturally occurring",
          "minEach": 2,
          "childrenOfRoots": true,
          "onlyIfOccurs": true,
          "requiredSteps": [
            "transcribe",
            "ft-lwc"
          ]
        },
        {
          "id": "idb-glossed",
          "kind": "count",
          "label": "A substantial subset glossed morpheme-by-morpheme",
          "min": null,
          "requiredSteps": [
            "morph"
          ],
          "note": "Original stated a byte quantity; set your own count for a hard target."
        },
        {
          "id": "idb-chart",
          "kind": "count",
          "label": "3 good-sized narrative texts fully charted",
          "min": 3,
          "scope": {
            "genre": "narrative",
            "minSentences": 20
          },
          "requiredSteps": [
            "charting"
          ],
          "note": "Handbook footnote: good-sized = 20–50 sentences."
        },
        {
          "id": "idb-pub",
          "kind": "count",
          "label": "Some texts published",
          "min": null,
          "requiredSteps": [
            "published"
          ]
        }
      ]
    },
    {
      "id": "sil-png",
      "label": "SIL PNG",
      "short": "PNG",
      "accent": "#10514D",
      "source": "Linguistics Workshop 2020, 'Collecting Texts', René van den Berg",
      "hasGenreField": false,
      "rules": [
        {
          "id": "png-pages",
          "kind": "quantity",
          "label": "200 pages of vernacular material",
          "field": "wordCount",
          "unit": "page",
          "min": 200,
          "note": "Translators' Handbook: 200 pages in the beginning stage — A4, 12pt, double-spaced, excluding Bible translation. Tracked as word count ÷ words-per-page.",
          "requiredSteps": []
        },
        {
          "id": "png-consent",
          "kind": "count",
          "label": "Informed consent for every text",
          "min": null,
          "requiredSteps": [
            "consent"
          ],
          "note": "Written signature or recorded oral agreement. An SIL International requirement for archiving."
        },
        {
          "id": "png-genres",
          "kind": "coverage",
          "label": "Spread across suggested genres",
          "min": null,
          "items": [
            "narr-folktale",
            "narr-legend",
            "narr-myth",
            "expr-riddle",
            "hort-proverb",
            "narr-personal",
            "narr-dream",
            "hort-sermon",
            "procedural",
            "hortatory",
            "expository",
            "narr-historical"
          ],
          "note": "The paper lists these as genres you CAN collect. No quota is stated — this tracks coverage.",
          "requiredSteps": []
        },
        {
          "id": "png-flex",
          "kind": "count",
          "label": "Keyboarded and interlinearised in FLEx",
          "min": null,
          "requiredSteps": [
            "flex",
            "morph"
          ]
        },
        {
          "id": "png-handover",
          "kind": "checklist",
          "label": "Corpus handover (collection-level, not per text)",
          "items": [
            {
              "id": "png-paper-archive",
              "label": "Printed copy lodged with the Linguistic Paper Archive"
            },
            {
              "id": "png-library",
              "label": "Printed copy lodged in the Linguistic Library (physical, on-site)"
            },
            {
              "id": "png-office",
              "label": "Electronic copy + signed release forms with the Linguistics Office"
            },
            {
              "id": "png-booklet",
              "label": "Community booklet produced and distributed (10–30 copies)"
            }
          ],
          "requiredSteps": []
        }
      ],
      "aliases": {
        "narr-folktale": "folk tales",
        "narr-personal": "personal stories",
        "narr-historical": "historical material",
        "procedural": "procedural",
        "hortatory": "hortatory",
        "expository": "expository"
      }
    }
  ]
